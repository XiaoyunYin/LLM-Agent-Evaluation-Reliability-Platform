# Secrets
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Node / frontend
node_modules/
dist/
*.local

# Raw benchmark output is local-only. Final reports and gate metrics are tracked.
runs/**
!runs/gpu_window_rehearsal/
!runs/gpu_window_rehearsal/gpu_window_validation_mock_12_candidate_answers.jsonl
!runs/gpu_window_rehearsal/gpu_window_validation_mock_12_heldout_120_eval_cases.jsonl
!runs/gpu_window_rehearsal/gpu_window_validation_mock_12_manual_review_queue.jsonl

# Local editor/agent state
.local-editor-state/

# OS
.DS_Store
Thumbs.db

# Downloaded and generated benchmark data is reproducible but not public source.
datasets/beir/_download/
datasets/squad_v2/_download/
datasets/beir/
datasets/corpus/

# Spider 1.0 is ~1 GB of SQLite databases. datasets/spider/PIN.json is committed
# so the exact archive is identified by sha256; re-fetch with
# `python scripts/download_spider.py`.
datasets/spider/*
!datasets/spider/PIN.json

# Personal editor and tooling config, not project configuration.
.editor-rules.md
.tooling-rules.md

# P3 support fixture is generated deterministically from a seed; the manifest is
# the reproducibility record.
datasets/support/*.sqlite
