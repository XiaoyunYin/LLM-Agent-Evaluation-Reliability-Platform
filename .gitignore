# Secrets
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Node / frontend
node_modules/
dist/
*.local

# Local run artifacts and scratch
runs/pytest_tmp*/
runs/pytest_cache*/
runs/pytest-cache-files-*/

# Nondeterministic pytest output. runs/test_regression_gate/ is kept on purpose:
# it holds the committed fixtures the CI gate test asserts against.
runs/test_bulk_judging/
runs/test_candidate_generation_pipeline/
runs/test_dual_judge_validation_artifacts/
runs/test_judge_validation_rehearsal/

# Local editor/agent state
.local-editor-state/

# OS
.DS_Store
Thumbs.db

# BEIR source archives; the converted chunks/labels are committed instead.
datasets/beir/_download/
datasets/squad_v2/_download/

# Spider 1.0 is ~1 GB of SQLite databases. datasets/spider/PIN.json is committed
# so the exact archive is identified by sha256; re-fetch with
# `python scripts/download_spider.py`.
datasets/spider/*
!datasets/spider/PIN.json
runs/trace_measure/
datasets/beir/*_train/chunks.jsonl

# Mock and rehearsal output. Useful for exercising the pipeline without spending
# money, but never counted toward a measured claim, so it is noise in the history.
runs/local_mock_*
runs/gpu_window_rehearsal/
runs/gpu_window_smoke/
runs/judge_validation_rehearsal/
runs/dual_judge_squad/rehearsal_mock7b_*
runs/spider_benchmark/mockrehearsal_*

# Spider run artifacts ARE committed - they are the evidence behind every
# published number, and `scripts/audit_p0_claims.py` recomputes each claim from
# them. `payloads.jsonl` (~20 MB per full run) is committed gzipped instead of
# dropped: it compresses ~18x, and every reader goes through
# `backend.app.spider.trajectory.open_jsonl`, which accepts either form.
runs/spider_benchmark/*/payloads.jsonl

# Personal editor and tooling config, not project configuration.
.editor-rules.md
.tooling-rules.md

# The P1 run family IS committed - it is the evidence behind the variance
# envelope and the CI thresholds. Only its large payload blobs are gzipped, like
# every other run.

# P3 support fixture is generated deterministically from a seed; PIN is the record.
datasets/support/*.sqlite
runs/_support_qa_tmp/
