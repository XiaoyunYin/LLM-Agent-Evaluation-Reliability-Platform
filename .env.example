# Copy to .env and fill in. .env is gitignored and must never be committed.
# cp .env.example .env

# --- Paid provider APIs (candidate generation + the 120-answer judge slice) ---
# Mock generation is the default, so these are only needed for real runs.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Local data services (docker compose up -d postgres elasticsearch redis) ---
# Host port is 5433, not 5432, to avoid a local Postgres port conflict.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/llm_eval
# Use 127.0.0.1 rather than localhost; the IPv6 form intermittently refuses.
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=llm_eval_chunks
REDIS_URL=redis://localhost:6379/0

# --- Self-hosted judge (vLLM, OpenAI-compatible endpoint) ---
# Point at the mock server for local rehearsal, or at vLLM during a GPU window.
SELF_HOSTED_JUDGE_URL=http://127.0.0.1:8001/v1/chat/completions
SELF_HOSTED_JUDGE_MODEL=mistral-7b-instruct-v0.3-awq
SELF_HOSTED_JUDGE_TIMEOUT_SECONDS=120
SELF_HOSTED_JUDGE_MAX_RETRIES=3
SELF_HOSTED_JUDGE_RETRY_BACKOFF_SECONDS=2
# vLLM needs no key by default; set only if you put an auth proxy in front.
SELF_HOSTED_JUDGE_API_KEY=

# --- Optional self-hosted candidate generation (not required) ---
SELF_HOSTED_MODEL_ENDPOINT=

# --- Tracing ---
# Unset: spans go to the console. Set: spans go to the OTel Collector over gRPC.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
